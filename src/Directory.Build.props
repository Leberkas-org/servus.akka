<Project>

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <!-- slopwatch-ignore: SW005 QUIC APIs are platform-guarded at runtime; CA1416 false-positives on conditional usage -->
        <NoWarn>CA1416</NoWarn>
    </PropertyGroup>

    <!-- SourceLink -->
    <PropertyGroup>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <DebugType>embedded</DebugType>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
    </PropertyGroup>

    <!-- NuGet Package Metadata -->
    <PropertyGroup Condition="!$(MSBuildProjectName.Contains('Test'))">
        <Company>Leberkas-org</Company>
        <PackageIcon>logo.png</PackageIcon>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageLicenseFile>LICENSE</PackageLicenseFile>
        <!--<PackageProjectUrl>https://servusakka.readthedocs.io</PackageProjectUrl>-->
        <RepositoryUrl>https://github.com/Leberkas-org/servus.akka</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <Copyright>Copyright (c) Leberkas-org 2025-$([System.DateTime]::Now.Year)</Copyright>
    </PropertyGroup>

    <!-- Non-packable projects -->
    <PropertyGroup Condition="$(MSBuildProjectName.Contains('Test'))">
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <!-- Test runner projects -->
    <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('.Tests'))">
        <OutputType>Exe</OutputType>
        <IsTestProject>true</IsTestProject>
    </PropertyGroup>

    <!-- Test runner packages and usings -->
    <ItemGroup Condition="$(MSBuildProjectName.EndsWith('.Tests'))">
        <Using Include="Xunit"/>
        <PackageReference Include="xunit.v3.mtp-v2"/>
        <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage"/>
    </ItemGroup>

    <!-- Packable project assets -->
    <ItemGroup Condition="!$(MSBuildProjectName.Contains('Test'))">
        <None Include="../../README.md" Pack="true" Visible="false" PackagePath="\"/>
        <None Include="../../logo.png" Pack="true" Visible="false" PackagePath="\"/>
        <None Include="../../LICENSE" Pack="true" Visible="false" PackagePath="\"/>
    </ItemGroup>

</Project>
